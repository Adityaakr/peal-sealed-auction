{
  "name": "peal-sealed-auction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Peal Sealed Auction: a uniform-price sealed-bid auction on QoreChain whose bids no single key holder can open early.",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "typecheck": "tsc --noEmit",
    "abi": "forge build && tsx scripts/gen-abi.ts",
    "test:ts": "vitest run",
    "e2e:local": "forge build && tsx scripts/e2e-local.ts",
    "committee": "tsx apps/committee/daemon.ts",
    "local:stack": "forge build && tsx scripts/local-stack.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "proxy": "tsx proxy/server.ts",
    "web:smoke": "forge build && tsx scripts/web-smoke.ts",
    "testnet": "tsx scripts/testnet/cli.ts",
    "web:preview": "tsx scripts/web-preview.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/sdk": "0.14.0",
    "cosmjs-types": "0.11.0",
    "qore-pq-kit": "github:Adityaakr/qore-pq-kit#v0.1.0",
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "playwright-core": "1.56.1",
    "tsx": "4.19.0",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "3.2.4"
  }
}
