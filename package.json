{
  "name": "peal-sealed-auction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Peal Sealed Auction: a uniform-price sealed-bid auction on QoreChain whose bids no single key holder can open early.",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "typecheck": "tsc --noEmit",
    "abi": "forge build && tsx scripts/gen-abi.ts",
    "test:ts": "vitest run",
    "e2e:local": "forge build && tsx scripts/e2e-local.ts",
    "committee": "tsx apps/committee/daemon.ts",
    "local:stack": "forge build && tsx scripts/local-stack.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "proxy": "tsx proxy/server.ts",
    "web:smoke": "forge build && tsx scripts/web-smoke.ts",
    "testnet": "tsx scripts/testnet/cli.ts",
    "web:preview": "tsx scripts/web-preview.ts",
    "evidence": "tsx scripts/evidence.ts",
    "cbom": "qorescan scan --network testnet --solidity src --solidity lib/qore-pq-kit/src --address qor1e8kr7whjwt2trzghlwswt337gptdn0jqz33zrh --address qor1vnhz8997jwcwss9sdl2f0husu5540phwjx0pdx --address qor1ppnar99nxc8wq4pyjwt029v0ktcel55952jaj3 --tls api-testnet.qore.host:443 --tls evm-testnet.qore.host:443 --name peal-sealed-auction --out docs/qorescan/cbom.json && qorescan template agility --cbom docs/qorescan/cbom.json --out docs/qorescan/agility-statement.md"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/qorex-types": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "@qorechain/wallet-adapter": "0.6.0",
    "cosmjs-types": "0.11.0",
    "qore-pq-kit": "github:Adityaakr/qore-pq-kit#v0.1.0",
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@qorechain/mcp": "0.1.1",
    "@qorechain/qore-cli": "0.1.1",
    "@qorechain/qorescan": "0.1.0",
    "@qorechain/qorex-wallet-mock": "0.1.0",
    "@types/node": "22.7.5",
    "playwright-core": "1.56.1",
    "tsx": "4.19.0",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@qorechain/wallet-adapter": {
      "@cosmjs/stargate": "$@cosmjs/stargate",
      "@cosmjs/proto-signing": "$@cosmjs/proto-signing"
    }
  }
}
